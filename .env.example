# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Importación de gastos desde correo (v1.3.0)
# Google Cloud → APIs y servicios → Credenciales (cliente OAuth tipo "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 3.3.0 · Outlook personal: Azure Portal → App registrations ("Personal Microsoft accounts only")
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# 32 bytes en base64:  openssl rand -base64 32
MAIL_TOKEN_KEY=
# Supabase → Project Settings → API → service_role (SOLO servidor, nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Secreto compartido con el workflow de GitHub Actions:  openssl rand -hex 32
CRON_SECRET=

# Opcional (2.6.0): origen fijo de los enlaces que manda Supabase por correo.
# Sin valor se usa el del request (producción o local).
NEXT_PUBLIC_SITE_URL=

# 2.9.0 (Constelación, Stellar testnet). Cavos (wallet con correo/Google):
# App ID público del dashboard. Nunca una API key cav_… ni claves S….
NEXT_PUBLIC_CAVOS_APP_ID=
# development (por defecto) o production, según la app de Cavos.
NEXT_PUBLIC_CAVOS_ENVIRONMENT=
# 3.0.0: id público del contrato family (ver contracts/Versionamiento/).
NEXT_PUBLIC_FAMILY_CONTRACT_ID=CBP3Y7EMTKUXSD3SDDC6IVM3U2KRZIO5I2XEBRGNNLO73KKTAPTN77ON

# 3.2.0 (Fase 1, opcional): tiempos de cada render y consulta en el log del
# servidor (PERF_LOG) y de cada navegación en la consola (NEXT_PUBLIC_PERF_LOG,
# se fija al compilar). Dejar vacías en producción salvo para medir.
PERF_LOG=
NEXT_PUBLIC_PERF_LOG=

# 3.2.0: Constelación (Stellar testnet). 1 = se ve la pestaña; vacío = apagada
# (404 en /trading). Apagada en producción hasta la 4.0.0.
NEXT_PUBLIC_FEATURE_CONSTELLATION=

# 3.2.0 (Fase 4, opcional): Sentry. DSN del proyecto (es público). Sin valor,
# no se envía nada.
NEXT_PUBLIC_SENTRY_DSN=
