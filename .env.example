# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Importación de gastos desde correo (v1.3.0)
# Google Cloud → APIs y servicios → Credenciales (cliente OAuth tipo "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes en base64:  openssl rand -base64 32
MAIL_TOKEN_KEY=
# Supabase → Project Settings → API → service_role (SOLO servidor, nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Secreto compartido con el workflow de GitHub Actions:  openssl rand -hex 32
CRON_SECRET=

# Opcional (2.6.0): origen fijo de los enlaces que manda Supabase por correo.
# Sin valor se usa el del request (producción o local).
NEXT_PUBLIC_SITE_URL=

# 2.9.0 (Constelación, Stellar testnet). Cavos (wallet con correo/Google):
# App ID público del dashboard. Nunca una API key cav_… ni claves S….
NEXT_PUBLIC_CAVOS_APP_ID=
# development (por defecto) o production, según la app de Cavos.
NEXT_PUBLIC_CAVOS_ENVIRONMENT=
